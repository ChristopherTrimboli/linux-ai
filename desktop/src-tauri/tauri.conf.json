{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux AI Companion",
  "identifier": "dev.linux-ai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "Linux AI Companion",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "AI companion for your Linux desktop",
    "longDescription": "A Linux-first AI chat companion with tool-based access to your computer and a matching CLI."
  }
}
